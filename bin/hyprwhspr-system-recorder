#!/usr/bin/env python3
import array
import math
import os
from pathlib import Path
import signal
import subprocess
import sys
import wave

parec, device, output, feed = sys.argv[1:]
running = True


def stop(_signum, _frame):
    global running
    running = False


def write_feed(samples):
    count = 32
    buckets = []
    for index in range(count):
        values = samples[index * len(samples) // count:(index + 1) * len(samples) // count]
        buckets.append(math.sqrt(sum(value * value for value in values) / len(values)) / 32768)
    level = max(abs(value) for value in samples) / 32768
    path = Path(feed)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(" ".join(f"{value:.6f}" for value in [level, *buckets]))
    os.replace(temporary, path)


signal.signal(signal.SIGINT, stop)
signal.signal(signal.SIGTERM, stop)
Path(output).parent.mkdir(parents=True, exist_ok=True)
Path(feed).parent.mkdir(parents=True, exist_ok=True)
process = subprocess.Popen(
    [
        parec,
        "--device",
        device,
        "--rate",
        "16000",
        "--format",
        "s16le",
        "--channels",
        "1",
        "--latency-msec",
        "20",
        "--process-time-msec",
        "20",
        "--raw",
    ],
    stdout=subprocess.PIPE,
    stderr=subprocess.DEVNULL,
    bufsize=0,
)
try:
    with wave.open(output, "wb") as recording:
        recording.setnchannels(1)
        recording.setsampwidth(2)
        recording.setframerate(16000)
        while running:
            chunk = process.stdout.read(1024)
            if not chunk:
                break
            recording.writeframesraw(chunk)
            samples = array.array("h", chunk)
            if sys.byteorder != "little":
                samples.byteswap()
            write_feed(samples)
finally:
    if process.poll() is None:
        process.terminate()
    process.wait()
