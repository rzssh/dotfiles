#!/usr/bin/env bash
set -euo pipefail

base=/home/razen/projects/dotfiles/config/herdr/config.toml
theme=${XDG_CACHE_HOME:-$HOME/.cache}/matugen/herdr-theme.toml
target=${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml
directory=${target%/*}

mkdir -p "$directory"
temporary=$(mktemp "$directory/.config.XXXXXX")
trap 'rm -f "$temporary"' EXIT

if [[ -f $theme ]]; then
  { cat "$base"; printf '\n'; cat "$theme"; } > "$temporary"
else
  cp "$base" "$temporary"
fi

cmp -s "$temporary" "$target" && exit
chmod 600 "$temporary"
mv -fT "$temporary" "$target"
/etc/profiles/per-user/razen/bin/herdr server reload-config >/dev/null 2>&1 || true
